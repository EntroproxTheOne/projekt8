# Copy this file to .env in the project root and fill in keys there.
# Restart the server after changing .env. Demo mode needs no keys.
# Leave unused keys blank. Never put real credentials in this example file.
# Live adapters and model availability still need verification with your account.

# Required for story planning and Markup Studio screenshot-to-HTML.
# Also used for Gemini image generation (including image fallback) and Gemini TTS.
GEMINI_API_KEY=
GEMINI_OMNI_MODEL=gemini-omni-1.1-flash

# Required for scene images with the default IMAGE_PROVIDER=grok.
# Grok (xAI) and Groq below are different services and use different keys.
GROK_API_KEY=

# Required for narration with the default AUDIO_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# Optional: transcription for word-level caption timings and audio fallback.
# Without this key, Deepgram/Gemini narration uses estimated word timings.
GROQ_API_KEY=

# Optional: required only when selecting ElevenLabs for narration.
ELEVENLABS_API_KEY=

# Optional/future: adapter exists, but the current Studio service factory
# does not select OpenRouter. Adding this key alone does not enable routing.
OPENROUTER_API_KEY=

OUTPUT_DIR=outputs
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
NETWORK_TIMEOUT_SECONDS=300

# Default live setup needs GEMINI_API_KEY, GROK_API_KEY, DEEPGRAM_API_KEY.
# Add GROQ_API_KEY for transcription-based caption timings.
# Audio choices: deepgram, elevenlabs, gemini, groq.
# The voice choice in the UI or CLI can override AUDIO_PROVIDER.
AUDIO_PROVIDER=deepgram
# Image choices: grok, gemini. Selecting gemini removes the need for a Grok key.
IMAGE_PROVIDER=grok
# Planner currently always uses Gemini; keep this value as gemini.
PLANNER_PROVIDER=gemini

# Existing app model defaults; change if your account requires other model IDs.
# These are model/voice identifiers, not API keys.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GROK_IMAGE_MODEL=grok-imagine-image
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
